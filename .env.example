# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_BACKEND_URL: URL pública del Cloudflare Worker echtagro-backend
# Ejemplo: https://echtagro-backend.mi-cuenta.workers.dev
# En Cloudflare Pages, configurar esta variable en Settings -> Environment Variables.
VITE_BACKEND_URL=""
